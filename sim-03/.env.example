# Session storage. Vercel's KV integration sets these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared with the platform. Verifies launch tokens so a student arriving from
# a course is not asked for a code the platform never gave them.
LAUNCH_SECRET=

# Optional. Standalone use outside the platform — anyone with the link is
# asked for this. Leave blank to leave the deployment open.
ACCESS_CODE=

# Optional. Where to report completions back to.
PLATFORM_URL=

# NOTE: no ANTHROPIC_API_KEY. Sims 01 and 02 need one; this sim has no model
# in the loop and will not use one if you set it.
