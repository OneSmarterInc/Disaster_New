# Session storage. Vercel's KV integration sets these for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared with the platform. Verifies launch tokens so a student arriving from
# a course is not asked for a code the platform never gave them.
LAUNCH_SECRET=

# Standalone use outside the platform — anyone opening the sim directly is
# asked for this, the same as sims 01 and 02. Leave blank to leave the
# deployment open to anyone with the link. A launch token from the platform
# stands in for it entirely, so students arriving from a course are never asked.
#
# Can also be passed in the link as ?code=... or #code=..., which is what
# faculty hand out.
ACCESS_CODE=

# Optional. Where to report completions back to.
PLATFORM_URL=

# NOTE: no ANTHROPIC_API_KEY. Sims 01 and 02 need one; this sim has no model
# in the loop and will not use one if you set it.
