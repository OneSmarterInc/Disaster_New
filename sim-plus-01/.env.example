# Shared with the platform. Both directions of the contract use it: launch
# tokens are verified with it, and completions and transcripts are signed
# with it. Must match the platform's LAUNCH_SECRET exactly.
LAUNCH_SECRET=

# Where to report completions and transcripts.
PLATFORM_URL=https://rapidsims.flexee.org

# This sim's stable, platform-proxied address. Without it the sim registers
# whatever host it happens to answer on, and launches redirect to the
# catalogue instead of into the run.
SIM_URL=https://rapidsims.flexee.org/simplus01

# Session storage. Vercel's KV integration sets these. Without them sessions
# live in memory and vanish on every cold start, which breaks resume entirely.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: lets someone play without a platform launch. Leave unset in
# production, where the platform is the only way in.
ACCESS_CODE=
